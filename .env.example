# demo does not call any external API. qwen requires all three fields below.
LLM_MODE=demo
QWEN_BASE_URL=https://llm.alem.ai/v1
QWEN_MODEL=qwen3-6
QWEN_API_KEY=
# Alem qwen3-8: disable reasoning for short voice-assistant replies.
# Uncomment after confirming support with your provider/model.
# QWEN_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=15

# Enable only after adding your own Alem key. May differ from Qwen key.
STT_ENABLED=false
STT_BASE_URL=https://llm.alem.ai/v1
# Alternative Kazakh model: speech-to-text-kk
STT_MODEL=speech-to-text-kk
STT_API_KEY=
# Optional; leave blank until language support is confirmed.
STT_LANGUAGE=
STT_TIMEOUT_SECONDS=60

# Separate speech-to-speech test at /realtime. Keep the key only in .env.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING=minimal
OPENAI_REALTIME_TIMEOUT_SECONDS=25
