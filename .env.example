# Main dialogue: OpenAI. Without a key the page shows a configuration message.
# Use demo for fixed local answers without a model API.
LLM_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=15
# Inactive text sessions expire; persisted callback operations remain available.
SESSION_IDLE_TIMEOUT_SECONDS=1800

# Enable only after adding your own Alem STT key.
STT_ENABLED=false
STT_BASE_URL=https://llm.alem.ai/v1
# Alternative Kazakh model: speech-to-text-kk
STT_MODEL=speech-to-text
STT_API_KEY=
# Optional; leave blank until language support is confirmed.
STT_LANGUAGE=
STT_TIMEOUT_SECONDS=60

# Separate speech-to-speech test at /realtime, using the same OPENAI_API_KEY.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING=minimal
# Shorter silence ends turns sooner; increase if pauses split a sentence.
OPENAI_REALTIME_SILENCE_MS=300
OPENAI_REALTIME_TIMEOUT_SECONDS=25

# Primary CRM application; API key belongs to a restricted EspoCRM API User.
# Local bootstrap writes this separately to ignored .env.espocrm.
ESPOCRM_URL=http://127.0.0.1:8080
ESPOCRM_API_KEY=
ESPOCRM_TIMEOUT_SECONDS=10

# Explicit assignee for confirmed callback tasks. Empty disables the workflow.
# Use a permitted employee's EspoCRM ID; the model cannot select the assignee.
CALLBACK_ASSIGNEE_ID=
CALLBACK_STORE_PATH=runtime/callbacks.sqlite3
